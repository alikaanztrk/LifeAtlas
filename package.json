{
  "name": "lifeatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "fixture:generate": "node scripts/generate-fixture.mjs",
    "scan:artifacts": "node scripts/scan-artifacts.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@noble/hashes": "2.4.0",
    "dexie": "4.4.7",
    "echarts": "6.1.0",
    "i18next": "27.2.9",
    "lucide-react": "1.81.0",
    "maplibre-gl": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
